{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["dashboard/**/*.ts", "dashboard/**/*.tsx", "dashboard/**/*.d.ts", "scenes/**/*.ts", "scenes/**/*.tsx", "scenes/**/*.d.ts", "client/**/*.ts", "client/**/*.tsx", "client/**/*.d.ts", "shared/**/*.ts", "shared/**/*.d.ts", "vite.config.ts"]
}
